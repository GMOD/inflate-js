{
  "name": "@gmod/inflate",
  "version": "1.0.0",
  "packageManager": "pnpm@11.15.1",
  "description": "Fast DEFLATE decompression via wasm libdeflate, inlined as a single bundle",
  "license": "MIT",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GMOD/inflate-js.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "import": "./esm/index.js",
    "require": "./dist/index.js"
  },
  "author": {
    "name": "Colin Diesh",
    "email": "colin.diesh@gmail.com",
    "url": "https://github.com/cmdcolin"
  },
  "files": [
    "dist",
    "esm",
    "src"
  ],
  "scripts": {
    "test": "vitest",
    "test:pack": "./scripts/test-pack.sh",
    "clean": "rimraf dist esm",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.lint.json",
    "prebuild": "pnpm clean",
    "build:wasm": "pnpm --filter inflate-wasm-build build",
    "build:esm": "tsc --outDir esm",
    "build:es5": "tsc --module commonjs --moduleResolution bundler --outDir dist",
    "postbuild:es5": "echo '{\"type\": \"commonjs\"}' > dist/package.json",
    "build": "pnpm build:wasm && pnpm build:esm && pnpm build:es5",
    "benchonly": "vitest bench",
    "coverage": "pnpm test --coverage",
    "preversion": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test --run && pnpm build && pnpm test:pack",
    "version": "git-cliff --tag v$npm_package_version --unreleased --prepend CHANGELOG.md && git add CHANGELOG.md",
    "postversion": "git push --follow-tags"
  },
  "keywords": [
    "deflate",
    "inflate",
    "zlib",
    "libdeflate",
    "wasm",
    "decompression"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "^4.17.1",
    "git-cliff": "^2.13.1",
    "pako-esm2": "^2.0.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
